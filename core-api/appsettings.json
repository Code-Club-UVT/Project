{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "CoreApi",
    "Audience": "gateway",
    "PrivateKeyPem": "",
    "AccessTokenMinutes": 15,
    "ProjectTokenMinutes": 5
  },
  "Internal": {
    "ApiKey": "CHANGE-ME-development-only-internal-key-0123456789abcdef"
  },
  "RefreshToken": {
    "Days": 7,
    "AbsoluteDays": 30,
    "CookieName": "refreshToken",
    "CookiePath": "/api/core/auth",
    "CookieSecure": true
  },
  "Auth": {
    "EmailConfirmationHours": 24,
    "PasswordResetHours": 1
  },
  "Smtp": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "Password": "CHANGE-ME-smtp-password",
    "FromAddress": "",
    "FromName": "Core API",
    "TimeoutSeconds": 15
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173",
    "ConfirmEmailPath": "/confirm-email",
    "ResetPasswordPath": "/reset-password"
  }
}
