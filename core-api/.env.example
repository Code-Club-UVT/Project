# Copy to .env to override the defaults used by docker-compose.yml.
# The defaults below match ConnectionStrings:PostgresConnection in appsettings.Development.json.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=platform
POSTGRES_PORT=5432

# pgAdmin (only started with: docker compose --profile tools up -d)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
