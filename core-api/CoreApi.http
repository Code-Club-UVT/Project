@CoreApi_HostAddress = http://localhost:5054
@accessToken =

### Register
POST {{CoreApi_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "john",
  "email": "john@example.com",
  "password": "brand-new-password-1",
  "firstName": "John",
  "lastName": "Doe"
}

### Confirm email (the token is in the link written to the log in Development)
POST {{CoreApi_HostAddress}}/api/auth/confirm-email
Content-Type: application/json

{ "token": "" }

### Login (identifier = username or email). Sets the refresh cookie; copy accessToken above
POST {{CoreApi_HostAddress}}/api/auth/login
Content-Type: application/json

{ "identifier": "john", "password": "brand-new-password-1" }

### Refresh (uses the refresh cookie)
POST {{CoreApi_HostAddress}}/api/auth/refresh

### Logout
POST {{CoreApi_HostAddress}}/api/auth/logout

### Forgot password
POST {{CoreApi_HostAddress}}/api/auth/forgot-password
Content-Type: application/json

{ "email": "john@example.com" }

### Reset password
POST {{CoreApi_HostAddress}}/api/auth/reset-password
Content-Type: application/json

{ "token": "", "newPassword": "another-long-password-456" }

### Current user
GET {{CoreApi_HostAddress}}/api/users/me
Authorization: Bearer {{accessToken}}

### Update profile
PUT {{CoreApi_HostAddress}}/api/users/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "firstName": "John", "lastName": "Doe" }

### Change password
POST {{CoreApi_HostAddress}}/api/users/me/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "currentPassword": "a-long-password-123", "newPassword": "another-long-password-456" }

### List users (Admin only)
GET {{CoreApi_HostAddress}}/api/users?page=1&pageSize=20
Authorization: Bearer {{accessToken}}
