{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "identity",
    "Audience": "gateway",
    "PrivateKeyPem": "",
    "AccessTokenMinutes": 15,
    "ProjectTokenMinutes": 5
  },
  "InternalAuth": {
    "Callers": {
      "gateway": "CHANGE-ME-development-only-internal-key-0123456789abcdef"
    }
  },
  "Services": {
    "Core": {
      "Url": "http://localhost:5054",
      "Key": "CHANGE-ME-development-only-identity-to-core-key-01234"
    },
    "Email": {
      "Url": "http://localhost:5070",
      "Key": "CHANGE-ME-development-only-identity-to-email-key-0123"
    },
    "TimeoutSeconds": 10
  },
  "Outbox": {
    "PollSeconds": 2,
    "BatchSize": 20,
    "MaxAttempts": 30,
    "FirstBackoffSeconds": 2,
    "MaxBackoffSeconds": 600,
    "LeaseSeconds": 60
  },
  "RefreshToken": {
    "Days": 7,
    "AbsoluteDays": 30,
    "CookieName": "refreshToken",
    "CookiePath": "/api/identity/auth",
    "CookieSecure": true
  },
  "Auth": {
    "EmailConfirmationHours": 24,
    "PasswordResetHours": 1
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173",
    "ConfirmEmailPath": "/confirm-email",
    "ResetPasswordPath": "/reset-password"
  }
}
