# Placeholders only. `node init.mjs` creates .env (gitignored) from this list with random values.
LOCAL_HTTP_PORT=8080
LOCAL_PG_PORT=5432

PG_ADMIN_PASSWORD=CHANGE-ME
PG_IDENTITY_PASSWORD=CHANGE-ME
PG_CORE_PASSWORD=CHANGE-ME
PG_EMAIL_PASSWORD=CHANGE-ME
PG_GATEWAY_PASSWORD=CHANGE-ME

# One key per caller of an /internal endpoint (see platform-kit/docs).
KEY_GATEWAY_IDENTITY=CHANGE-ME
KEY_IDENTITY_CORE=CHANGE-ME
KEY_IDENTITY_EMAIL=CHANGE-ME

# The first admin (created confirmed at startup; admin rights are the Admin role on the core project).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE-ME

# Email is really sent through this SMTP account. SMTP_ENABLED=false only writes the emails to the email-api log.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=CHANGE-ME-smtp-password
SMTP_FROM=
