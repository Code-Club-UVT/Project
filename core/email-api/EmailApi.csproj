<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The tests live in a folder of this project but are their own project. -->
  <ItemGroup>
    <Compile Remove="EmailApi.Tests/**" />
    <Content Remove="EmailApi.Tests/**" />
    <EmbeddedResource Remove="EmailApi.Tests/**" />
    <None Remove="EmailApi.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\common\platform-kit\PlatformKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
