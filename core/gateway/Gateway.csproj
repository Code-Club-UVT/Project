<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder; keep its sources out of the gateway itself. -->
    <Compile Remove="Gateway.Tests/**" />
    <Content Remove="Gateway.Tests/**" />
    <EmbeddedResource Remove="Gateway.Tests/**" />
    <None Remove="Gateway.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\common\platform-kit\PlatformKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

</Project>
